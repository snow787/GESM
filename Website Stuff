  const byId = id => articles.find(a => a.id === id);

  // ---------- Nav rendering ----------
  const navEl = document.getElementById('topicNav');
  let activeTopic = 'home';

  function renderNav() {
    navEl.innerHTML = topics.map(t =>
      `<button class="topic-pill ${t.id === activeTopic ? 'active' : ''}" data-topic="${t.id}">${t.name}</button>`
    ).join('');
    navEl.querySelectorAll('.topic-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        activeTopic = btn.dataset.topic;
        renderNav();
        renderGrid(activeTopic);
        showGrid();
      });
    });
  }

  // ---------- Card templates ----------
  function heroTemplate(a) {
    return `
      <article class="hero-card fade-in" data-id="${a.id}">
        <p class="eyebrow">${a.eyebrow}</p>
        <h2 class="hero-headline">${a.headline}</h2>
        <p class="hero-dek">${a.dek}</p>
        <div class="card-meta"><span>${a.author}</span><span>&middot;</span><span>${a.read} read</span></div>
      </article>`;
  }

  function cardTemplate(a) {
    return `
      <div class="card" data-id="${a.id}">
        <p class="eyebrow">${a.eyebrow}</p>
        <h3 class="card-headline">${a.headline}</h3>
        <p class="card-dek">${a.dek}</p>
      </div>`;
  }

  function attachCardHandlers(container) {
    container.querySelectorAll('[data-id]').forEach(el => {
      el.addEventListener('click', () => {
        renderArticle(el.dataset.id);
        showArticle();
      });
    });
  }

  // ---------- Grid rendering ----------
  function renderGrid(topicId) {
    const gridEl = document.getElementById('gridView');
    let hero, sections;

    if (topicId === 'home') {
      hero = articles.find(a => a.homeFeatured);
      sections = [
        { label: 'Trending Now', ids: ['sp1', 'cl1', 'vc1'] },
        { label: 'Around Campus', ids: ['bz2', 'cf1', 'cl3'] },
        { label: 'From the Homework Desk', ids: ['hw1', 'hw4', 'hw2'] },
      ].map(s => ({ label: s.label, items: s.ids.map(byId) }));
    } else {
      const topicArticles = articles.filter(a => a.topic === topicId);
      hero = topicArticles.find(a => a.featured);
      const rest = topicArticles.filter(a => a.id !== hero.id);
      const groups = {};
      rest.forEach(a => { (groups[a.eyebrow] = groups[a.eyebrow] || []).push(a); });
      sections = Object.keys(groups).map(label => ({ label, items: groups[label] }));
    }

    gridEl.innerHTML = heroTemplate(hero) +
      `<div class="sections-grid">` +
      sections.map(s => `
        <div class="section-block">
          <p class="section-header">${s.label}</p>
          <div class="card-list">${s.items.map(cardTemplate).join('')}</div>
        </div>`).join('') +
      `</div>`;

    attachCardHandlers(gridEl);
  }

  // ---------- Article rendering ----------
  function renderArticle(id) {
    const a = byId(id);
    const topicName = topics.find(t => t.id === a.topic).name;
    const el = document.getElementById('articleView');
    el.innerHTML = `
      <button class="back-btn" id="backBtn">&larr; Back to ${activeTopic === 'home' ? 'Home' : topicName}</button>
      <p class="eyebrow">${a.eyebrow}</p>
      <h1 class="article-headline">${a.headline}</h1>
      <div class="article-meta"><span>${a.author}</span><span>&middot;</span><span>${a.read} read</span><span>&middot;</span><span>${topicName}</span></div>
      <div class="article-body">
        ${a.body.map(p => `<p>${p}</p>`).join('')}
        ${a.tips ? `<div class="tips-list"><p>Quick tips</p><ul>${a.tips.map(t => `<li>${t}</li>`).join('')}</ul></div>` : ''}
      </div>`;
    document.getElementById('backBtn').addEventListener('click', showGrid);
  }

  function showGrid() {
    document.getElementById('gridView').classList.remove('hidden');
    document.getElementById('articleView').classList.add('hidden');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function showArticle() {
    document.getElementById('gridView').classList.add('hidden');
    const view = document.getElementById('articleView');
    view.classList.remove('hidden');
    view.classList.add('fade-in');
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // ---------- Init ----------
  renderNav();
  renderGrid('home');
</script>
